<core:FragmentDefinition
	xmlns="sap.ui.comp.valuehelpdialog"
	xmlns:m="sap.m"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:core="sap.ui.core">
	<ValueHelpDialog
		title="Product"
		ok=".onValueHelpOkPress"
		cancel=".onValueHelpCancelPress"
		afterClose=".onValueHelpAfterClose"
		supportRanges="true"
		supportMultiselect="false"
		key=""
		descriptionKey=""
		escapeHandler=".onEscape">
		<filterBar>
			<fb:FilterBar advancedMode="true" search="onFilterBarSearch" isRunningInValueHelpDialog="true">
				<fb:filterGroupItems>
					<fb:FilterGroupItem
						groupName="__$INTERNAL$"
						name="BillingDocument"
						label="Billing Document"
						visibleInFilterBar="true">
						<fb:control>
							<m:Input name="BillingDocument" />
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem
						groupName="__$INTERNAL$"
						name="BillingDocumentDate"
						label="BillingDocumentDate"
						visibleInFilterBar="true">
						<fb:control>
							<m:DatePicker valueFormat="yyyy-MM-dd" displayFormat="yyyy-MM-dd" name="BillingDocumentDate" />
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem
						groupName="__$INTERNAL$"
						name="BillingDocumentType"
						label="Billing Document Type"
						visibleInFilterBar="true">
						<fb:control>
							<m:Input name="YY1_SubBillingType_BDH" />
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem
						groupName="__$INTERNAL$"
						name="SalesOrganization"
						label="Sales Organization"
						visibleInFilterBar="true">
						<fb:control>
							<m:Input name="SalesOrganization" />
						</fb:control>
					</fb:FilterGroupItem>
					
					<fb:FilterGroupItem
						groupName="__$INTERNAL$"
						name="SoldToParty"
						label="Customer"
						visibleInFilterBar="true">
						<fb:control>
							<m:Input name="SoldToParty" />
						</fb:control>
					</fb:FilterGroupItem>
				</fb:filterGroupItems>
			</fb:FilterBar>
		</filterBar>
	</ValueHelpDialog>
</core:FragmentDefinition>