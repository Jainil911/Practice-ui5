<mvc:View
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
	xmlns:smartTable="sap.ui.comp.smarttable"
	controllerName="project1.controller.View4"
	height="100%">

	<Page title="Northwind Products">
		<smartFilterBar:SmartFilterBar id="smartFilterBar" entitySet="Products"	persistencyKey="SmartFilter_Products">
			<smartFilterBar:controlConfiguration>
				<smartFilterBar:ControlConfiguration key="ProductID">
					<smartFilterBar:defaultFilterValues>

					</smartFilterBar:defaultFilterValues> 
				</smartFilterBar:ControlConfiguration>

				<smartFilterBar:ControlConfiguration key="Discontinued"/>
				<smartFilterBar:ControlConfiguration key="UnitPrice"/>
			</smartFilterBar:controlConfiguration>
		</smartFilterBar:SmartFilterBar>

		<!-- <smartFilterBar:SmartFilterBar >
		<smartFilterBar:controlConfiguration>
			<smartFilterBar:ControlConfiguration key="Bukrs">
				
			</smartFilterBar:ControlConfiguration>
			<smartFilterBar:ControlConfiguration key="Gjahr">
				<smartFilterBar:defaultFilterValues>
					<smartFilterBar:SelectOption low="2014">
					</smartFilterBar:SelectOption>
				</smartFilterBar:defaultFilterValues>
			</smartFilterBar:ControlConfiguration>
		</smartFilterBar:controlConfiguration>
	</smartFilterBar:SmartFilterBar> -->

		<smartTable:SmartTable
			id="idSmartTable"
			entitySet="Products"
			smartFilterId="smartFilterBar"
			tableType="ResponsiveTable"
			enableAutoBinding="true"
			initiallyVisibleFields="ProductID,ProductName,UnitPrice,UnitsInStock,ReorderLevel,SupplierID,CategoryID,Discontinued"
			useTablePersonalisation="true"
			header="Products Catalog"
			enableExport="true"
			useVariantManagement="false" 
			enableAutoColumnWidth="false"
			demandPopin="true"
			class="sapUiResponsiveContentPadding" 
			showDetailsButton="true" 
			detailsButtonSetting="Low"
			beforeExport=".onBeforeExport" 
			persistencyKey="SmartTableAnalytical_Explored"
			showRowCount="true"
			>
		</smartTable:SmartTable>
	</Page>
</mvc:View>
